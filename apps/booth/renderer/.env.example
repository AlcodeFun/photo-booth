# Copy to .env.local and fill in your project values.
# https://supabase.com/dashboard/project/wxctgsodatmqnizchadn/settings/api
VITE_SUPABASE_URL=https://wxctgsodatmqnizchadn.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Cloudflare Worker (gallery API + R2). Used for all gallery file I/O.
VITE_GALLERY_URL=https://photo-booth-gallery.photo-booth-gallery.workers.dev

# Hosted web app base URL (the Vercel deployment of the booth renderer).
# Flow-2 QR codes point here (/organize/:token) instead of the Worker, because
# the arrange page is served by this app. Falls back to VITE_GALLERY_URL when
# unset. Example: https://your-booth.vercel.app
VITE_APP_URL=