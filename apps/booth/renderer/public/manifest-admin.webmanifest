{
  "id": "/admin",
  "name": "Kelana Admin",
  "short_name": "Kelana Admin",
  "description": "Kelana Photobooth admin dashboard.",
  "start_url": "/admin",
  "scope": "/admin",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#0B0B12",
